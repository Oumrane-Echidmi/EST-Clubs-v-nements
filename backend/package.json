{
  "name": "est-clubs-backend",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.20.0",
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "start:dev": "node --watch dist/src/main.js",
    "lint": "node node_modules/eslint/bin/eslint.js src test prisma scripts \u0026\u0026 node node_modules/prettier/bin/prettier.cjs --check .",
    "format": "node node_modules/prettier/bin/prettier.cjs --write .",
    "test": "node node_modules/jest/bin/jest.js --runInBand --config jest.config.cjs",
    "test:e2e": "node --import tsx scripts/test-e2e.ts",
    "prisma:generate": "node node_modules/prisma/build/index.js generate",
    "db:migrate": "node node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "node --import tsx prisma/seed.ts",
    "db:seed:demo": "node --import tsx prisma/seed-demo.ts",
    "openapi": "node node_modules/typescript/bin/tsc -p tsconfig.json \u0026\u0026 node dist/scripts/openapi.js",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.0",
    "firebase-admin": "14.5.1",
    "helmet": "^8.1.0",
    "nodemailer": "10.6.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "29.5.14",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.0.0",
    "jest": "29.7.0",
    "jest-util": "29.7.0",
    "prettier": "^3.6.0",
    "prisma": "7.10.1",
    "supertest": "^7.1.0",
    "ts-jest": "^29.4.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
